{
  "rewrites": [
    { "source": "/medical-seo-ai/:path*", "destination": "/:path*" },
    { "source": "/dental-seo-ai/:path*", "destination": "https://dental-seo-ai-programs.vercel.app/:path*" },
    { "source": "/medical-meta-advertising/:path*", "destination": "https://medical-meta-advertising-program.vercel.app/:path*" },
    { "source": "/medical-google-ads/:path*", "destination": "https://medical-google-ads-program.vercel.app/:path*" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "medical-seo-ai-programs.vercel.app" }],
      "destination": "https://programs.wisevu.com/medical-seo-ai/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ]
}
